{
	"compilerOptions": {
		"checkJs": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"module": "CommonJS",
		"moduleResolution": "node10",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ESNext",
		"noErrorTruncation": true,
		"paths": {
			"@yap/elaboration": ["./src/elaboration/index"],
			"@yap/elaboration/*": ["./src/elaboration/*"],
			"@yap/verification": ["./src/verification/index"],
			"@yap/verification/*": ["./src/verification/*"],
			"@yap/src/*": ["./src/parser/*"],
			"@yap/shared/*": ["./src/shared/*"],
			"@yap/utils": ["./src/utils/index"],
			"@yap/utils/*": ["./src/utils/*"],
			"@yap/gram": ["./src/GRAM/index"],
			"@yap/gram/*": ["./src/GRAM/*"],
			"@yap/pipeline": ["./src/pipeline/index"],
			"@yap/pipeline/*": ["./src/pipeline/*"]
		}
	},
	"include": ["src", "scripts/cli.ts"],
	"exclude": ["src/cli/explore/static", "tooling/syntax-highlighting"],
	"ts-node": {
		"require": ["tsconfig-paths/register"]
	}
}
