  :env -> [17]",
    "kind": "let",
    "mir": "module
  fn main entry=entry
    entry:
      let v0 = &closure_18
      return v0
  fn closure_18(print, name) entry=entry
    entry:
      let v0 = "Hello, "
      let v1 = ++(v0, name)
      let v2 = call *print(v1)
      let v3 = unit
      return v3",
    "name": "greet",
