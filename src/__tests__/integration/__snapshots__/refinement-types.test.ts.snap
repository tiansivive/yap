  const closure_cls2 = {
    __fn: fnref_cls2,
    __env: env_cls2
  };
  return closure_cls2;
}

function closure_24(env0, x1) {
  const cap_0 = env0.v0;
  const cap_1 = env0.v1;
  const v0 = 2;
  const v1 = (x1 * v0);
  const doubled2 = v1;
  const v3 = 10;
  const v4 = (doubled2 + v3);
  const added5 = v4;
  return added5;
}
return main();
",
    "elaborated": "λ(x: Num) ->
  {
    let doubled
      : <ω> Num [| λ(r: Num) ->
        (closure: FFI.$eq r (FFI.$mul x y) -| Γ: r; y; x) |]
      = FFI.$mul x 2;
    let added
      : <ω> Num [| λ(r: Num) ->
        (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]
      = FFI.$add doubled 10;
    return added;
  }",
