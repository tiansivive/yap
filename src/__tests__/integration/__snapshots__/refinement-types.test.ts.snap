  (forall ((doubled Real))
    (=>
      (= doubled (* doubled 2))
      (and
        (= x x)
        (forall ((x Real))
          (=>
            (= x x)
            (forall ((y Real))
              (=>
                (= y 2)
                (forall ((r Real)) (=> (= r (* x 2)) (= r (* doubled 2))))))))
        (forall ((added Real))
