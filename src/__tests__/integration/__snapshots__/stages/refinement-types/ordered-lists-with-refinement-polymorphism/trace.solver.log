## ascending (let)
=== Formula ===
  (and
    (forall (($b Real)) (=> (= $b 2) (< 1 $b)))
    (forall (($c Real)) (=> (= $c 3) (and (< 1 $c) (< 2 $c)))))

=== Variables ===
  proxy p1: true

=== Registry ===

=== Trace ===
[clauses]
