## hof (let)
=== Formula ===
  (and
    (forall (($a Real)) (=> (= $a 1) (>= $a 0)))
    (forall ((t1 Real)) (=> (= t1 1) (forall ((n Real)) (=> (>= n 0) (>= n 0))))))

=== Variables ===
  proxy p1: true

=== Registry ===

=== Trace ===
[clauses]
  #0: p1 -> unit: p1
  #1: p1 -> unit: p1

[propagate] p1 = true (forced by #0: p1 (true))
  trail: { p1@0 }
[clauses]
  #0: true -> satisfied
  #1: true -> satisfied

[theory] all assert p1: ok

[theory] all check: ok
  feasible

[sat]

[quantifier] round 0: 0 lemmas
[clauses]
  #0: p1 -> unit: p1
  #1: p1 -> unit: p1

[mbqi] round 0: 0 lemmas
  $a=1 -> tautology
  $a=0 -> tautology
  t1=1 -> residual
  t1=0 -> tautology
  n=1 -> tautology
  n=0 -> tautology
[clauses]
  #0: p1 -> unit: p1
  #1: p1 -> unit: p1

## hof2 (let)
=== Formula ===
  (forall ((t3 Real))
    (=>
      (= t3 1)
      (forall ((x Real))
        (=>
          (>= x 0)
          (forall ((y Real))
            (=> (= y 1) (forall ((r Real)) (=> (= r (+ x 1)) (> r 0)))))))))

=== Variables ===
  proxy p1: true

=== Registry ===

=== Trace ===
