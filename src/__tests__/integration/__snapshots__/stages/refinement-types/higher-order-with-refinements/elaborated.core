## Nat (let)
<ω> Num [| λ(n: Num) -> FFI.$gte n 0 |]

## Pos (let)
<ω> Num [| λ(p: Num) -> FFI.$gt p 0 |]

## hof (let)
λ(f: Π(t1: <ω> Num [| λ(n: Num) -> FFI.$gte n 0 |]) ->
  <ω> Num [| λ(n: Num) -> FFI.$gte n 0 |]) ->
  f 1

## hof2 (let)
λ(f: Π(t3: Num) -> <ω> Num [| λ(n: Num) -> FFI.$gte n 0 |]) -> FFI.$add (f 1) 1
