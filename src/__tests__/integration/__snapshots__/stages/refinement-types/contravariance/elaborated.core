## Nat (let)
<ω> Num [| λ(n: Num) -> FFI.$gte n 0 |]

## Pos (let)
<ω> Num [| λ(p: Num) -> FFI.$gt p 0 |]

## takePosFunction (let)
λ(f: Π(t2: Pos) -> Num) -> f 10

## natToNum (let)
λ(x: Nat) -> x

## posToNum (let)
λ(x: Pos) -> x

## result1 (let)
takePosFunction natToNum

## result2 (let)
takePosFunction posToNum
