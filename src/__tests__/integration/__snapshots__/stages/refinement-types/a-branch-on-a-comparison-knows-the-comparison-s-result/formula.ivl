  (and
    (= n!0 n!0)
    (forall ((x!5 Real))
      (=>
        (= x!5 0)
        (forall ((y!6 Real))
          (=>
            (= y!6 n!0)
            (forall (($fresh0 Bool))
              (=>
                (and (= $fresh0 (<= 0 n!0)) (= $fresh0 true))
                (and
                  (= n!0 n!0)
                  (forall (($r461!4 Real))
                    (=> (= $r461!4 n!0) (<= 0 $r461!4))))))))))
    (= n!0 n!0)
    (forall ((x!13 Real))
      (=>
        (= x!13 0)
        (forall ((y!14 Real))
          (=>
            (= y!14 n!0)
            (forall (($fresh1 Bool))
              (=>
                (and (= $fresh1 (<= 0 n!0)) (= $fresh1 false))
                (and
                  (= n!0 n!0)
