                    (=>
                      (= x!10 0)
                      (forall ((y!11 Real))
                        (=>
                          (= y!11 n!0)
                          (forall ((r!12 Real))
                            (=> (= r!12 (- 0 n!0)) (<= 0 r!12))))))))))))))))

