## block (let)
{
  let f
    : Π(t1: <ω> Num [| λ(st: State) ->
      (closure: λ(n: Num) -> FFI.$gt n 0 -| Γ: st; block) |]) ->
      (closure: <ω> Num [| λ(st: State) ->
        λ(p: Num) -> FFI.$gt p 1 |] -| Γ: t1; block)
    = λ(o: <ω> Num [| λ(st: State) -> λ(n: Num) -> FFI.$gt n 0 |]) ->
      FFI.$add o 1;
  return f 1;
}
