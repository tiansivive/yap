    (= x!0 x!0)
    (forall ((x!5 Real))
      (=>
        (= x!5 0)
        (forall ((y!6 Real))
          (=>
            (= y!6 x!0)
            (forall (($fresh0 Bool))
              (=>
                (and (= $fresh0 (<= 0 x!0)) (= $fresh0 true))
                (and
                  (= x!0 x!0)
                  (forall (($r563!4 Real))
                    (=> (= $r563!4 x!0) (<= 0 $r563!4))))))))))
    (= x!0 x!0)
    (forall ((x!13 Real))
      (=>
        (= x!13 0)
        (forall ((y!14 Real))
          (=>
            (= y!14 x!0)
            (forall (($fresh1 Bool))
