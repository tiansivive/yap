## firstOrZero (let)
=== Formula ===
  (forall ((list!0 Schema))
    (and
      (= list!0 list!0)
      (= list!0 list!0)
      (forall (($fresh1 Schema))
        (=>
          (and (= $fresh1 list!0) (= $fresh1 list!0))
          (forall ((x!2 Real)) (forall ((xs!3 Schema)) (= x!2 x!2)))))))

