## inc (let)
(and
  (forall ((x Real))
    (and
      (= x x)
      (forall ((x Real))
        (=>
          (= x x)
          (forall ((y Real))
            (=>
              (= y 1)
              (forall ((r Real)) (=> (= r (+ x 1)) (= r (+ x 1))))))))))
  (forall ((x Real)) (forall ((r Real)) (=> (= r (+ x 1)) (= r (+ x 1))))))

## fst (let)
(forall ((a Type))
  (forall ((b Type)) (forall ((x Type)) (forall ((y Type)) (= x x)))))
