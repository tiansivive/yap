## compute (let)
(forall ((x Real))
  (forall ((doubled Real))
    (=>
      (= doubled (* x 2))
      (and
        (= x x)
        (forall ((x Real))
          (=>
            (= x x)
            (forall ((y Real))
              (=>
                (= y 2)
                (forall ((r Real)) (=> (= r (* x 2)) (= r (* x 2))))))))
        (forall ((added Real))
          (=>
            (= added (+ (* x 2) 10))
            (and
              (= doubled (* x 2))
              (= doubled doubled)
              (forall ((x Real))
                (=>
                  (and (= x (* x 2)) (= x doubled))
                  (forall ((y Real))
                    (=>
                      (= y 10)
                      (forall ((r Real))
                        (=> (= r (+ doubled 10)) (= r (+ (* x 2) 10))))))))
              (= added (+ (* x 2) 10))
              (= added added))))))))

## result (let)
true
