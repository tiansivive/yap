## compute (let)
(forall ((x!0 Real))
  (forall ((doubled!1 Real))
    (=>
      (= doubled!1 (* x!0 2))
      (and
        (= x!0 x!0)
        (forall ((x!5 Real))
          (=>
            (= x!5 x!0)
            (forall ((y!6 Real))
              (=>
                (= y!6 2)
                (forall ((r!7 Real))
                  (=> (= r!7 (* x!0 2)) (= r!7 (* x!0 2))))))))
        (forall ((added!8 Real))
          (=>
            (= added!8 (+ (* x!0 2) 10))
            (and
              (= doubled!1 (* x!0 2))
              (= doubled!1 doubled!1)
              (forall ((x!12 Real))
                (=>
                  (and (= x!12 (* x!0 2)) (= x!12 doubled!1))
                  (forall ((y!13 Real))
                    (=>
                      (= y!13 10)
                      (forall ((r!14 Real))
                        (=>
                          (= r!14 (+ doubled!1 10))
                          (= r!14 (+ (* x!0 2) 10))))))))
              (= added!8 (+ (* x!0 2) 10))
              (= added!8 added!8))))))))

## result (let)
true
