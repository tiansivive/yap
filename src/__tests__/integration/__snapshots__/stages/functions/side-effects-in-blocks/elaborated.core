## print (foreign)


## stringify (foreign)


## debug (let)
λ(x: Num) ->
  {
    FFI.print "Computing...";
    let result
      : <ω> Num [| λ(r: Num) ->
        (closure: FFI.$eq r (FFI.$mul x y) -| Γ: r; y; x) |]
      = FFI.$mul x 2;
    FFI.print
      (FFI.stringify @<ω> Num [| λ(r: Num) -> FFI.$eq r (FFI.$mul x 2) |]
        result);
    return result;
  }
