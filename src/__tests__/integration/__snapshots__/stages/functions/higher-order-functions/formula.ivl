## compose (let)
(forall ((x Real)) (= x x))

## add1 (let)
(and
  (forall ((x Real))
    (and
      (= x x)
      (forall ((x Real))
        (=>
          (= x x)
          (forall ((y Real))
            (=>
              (= y 1)
              (forall ((r Real)) (=> (= r (+ x 1)) (= r (+ x 1))))))))))
  (forall ((x Real)) (forall ((r Real)) (=> (= r (+ x 1)) (= r (+ x 1))))))

