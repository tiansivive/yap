## double (let)
(and
  (forall ((x Real))
    (and
      (= x x)
      (forall ((x Real))
        (=>
          (= x x)
          (forall ((y Real))
            (=>
              (= y 2)
              (forall ((r Real)) (=> (= r (* x 2)) (= r (* x 2))))))))))
  (forall ((x Real)) (forall ((r Real)) (=> (= r (* x 2)) (= r (* x 2))))))

## add1ThenDouble (let)
true
