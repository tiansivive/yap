## add1ThenDouble (let)
module
  fn main entry=entry
    entry:
      let v0 = compose
      let v1 = double
      let fnref2 = read v0.__fn
      let env3 = read v0.__env
      let v4 = call *fnref2(env3, v1)
      let v5 = add1
      let fnref6 = read v4.__fn
      let env7 = read v4.__env
      let v8 = call *fnref6(env7, v5)
      return v8
