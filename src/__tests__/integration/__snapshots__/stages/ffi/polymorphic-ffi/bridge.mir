## prepend (foreign)


## id (foreign)


## nums (let)
module
  fn main entry=entry
    entry:
      let v0 = Num
      let v1 = 42
      let v2 = 1
      let v3 = 2
      let v4 = 3
      let v5 = alloc { 0: v2, 1: v3, 2: v4 }
      let v6 = call prepend(v0, v1, v5)
      return v6

## strs (let)
module
  fn main entry=entry
    entry:
      let v0 = String
      let v1 = "a"
      let v2 = "b"
      let v3 = "c"
      let v4 = alloc { 0: v2, 1: v3 }
      let v5 = call prepend(v0, v1, v4)
      return v5
