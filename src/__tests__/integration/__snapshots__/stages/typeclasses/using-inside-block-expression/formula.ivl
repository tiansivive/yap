## stringify (foreign)


## Show (let)
true

## Eq (let)
true

## ShowNum (let)
(forall ((n Real)) (= n n))

## EqNum (let)
(forall ((x Real)) (forall ((y Real)) (and (= x x) (= y y))))

## areEqual (let)
(forall ((t Type))
  (forall ((x Type)) (forall ((y Type)) (and (= x x) (= y y)))))

## result (let)
(forall ((same Bool)) (= same same))
