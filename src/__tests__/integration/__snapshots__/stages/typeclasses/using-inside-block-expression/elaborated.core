## stringify (foreign)


## Show (let)
λ(t: Type) ->
  Σ($sig: [ show: Irrelevant ]) . Schema [ show: Π(t3: t) -> String ]

## Eq (let)
λ(t: Type) ->
  Σ($sig: [ eq: Irrelevant ]) . Schema [ eq: Π(t5: t) -> Π(t6: t) -> Bool ]

## ShowNum (let)
νstrict [] . Struct [ show: λ(n: Num) -> FFI.stringify @Num n ]

## EqNum (let)
νstrict [] . Struct [ eq: λ(x: Num) -> λ(y: Num) -> FFI.$eq x y ]

## areEqual (let)
λ(t: Type) => λ(eq: Eq t) => λ(x: t) -> λ(y: t) -> ((eq).eq) x y

## result (let)
{ using EqNum; let same : Bool = areEqual @Num @EqNum 10 10; return same; }
