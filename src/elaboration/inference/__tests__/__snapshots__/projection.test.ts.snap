// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`inference: projection > ( { x: 1, y: 2 } ).x 1`] = `
{
  "displays": {
    "constraints": [
      "Num ~~ ?2",
      "Num ~~ ?1",
      "Schema [ x: Num, y: Num ] ~~ Schema [ x: Num, y: Num ]",
    ],
    "term": "(Struct [ x: 1, y: 2 ]).x",
    "type": "Num",
  },
}
`;

exports[`inference: projection > \\obj -> obj.x 1`] = `
{
  "displays": {
    "constraints": [
      "Schema [ x: ?2 | ?3 ] ~~ ?1",
    ],
    "term": "(λ(obj: (?1 :: Type)) -> (obj).x : Π(obj: (?1 :: Type)) -> (?2 :: Type))",
    "type": "Π(obj: ?1) -> (closure: (?2 :: Type) -| Γ: obj)",
  },
}
`;

exports[`inference: projection > { let proj = \\obj -> obj.x; } 1`] = `
{
  "displays": {
    "constraints": [
      "Schema [ x: ?3 | ?4 ] ~~ ?2",
      "Π(obj: ?2) -> (closure: (?3 :: Type) -| Γ: obj; proj) ~~ ?1",
    ],
    "term": "{
  let proj
    : Π(r: Row) =>
      (closure: Π(a: Type) => Π(obj: Schema [ x: a | r ]) -> a -| Γ: r; proj)
    = λ(r: Row) =>
      λ(a: Type) =>
        (λ(obj: Schema [ x: a | r ]) -> (obj).x : Π(obj: Schema [ x: a | r ]) ->
          a);
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`inference: projection > Projection from Sigma types > projects from a simple dependent pair 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "?1 ~~ L1",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "String ~~ ?4",
      "Num ~~ ?3",
      "String ~~ String",
      "String ~~ ?6",
      "Num ~~ Num",
      "Num ~~ ?5",
    ],
    "term": "{
  let Pair
    : Π(a: Type) -> (closure: Π(p: Π(t1: a) -> Type) -> Type -| Γ: a)
    = λ(a: Type) ->
      λ(p: Π(t1: a) -> Type) ->
        Σ($sig: [ snd: p :fst, fst: a ]) . Schema [ snd: p :fst, fst: a ];
  let p
    : Σ($sig: [ snd: String, fst: Num ]) .
      (closure: Schema [ snd: p :fst, fst: a ] -| Γ: p; a; Pair)
    = Struct [ snd: "hello", fst: 1 ];
  return (p).snd;
}",
    "type": "String",
  },
}
`;
