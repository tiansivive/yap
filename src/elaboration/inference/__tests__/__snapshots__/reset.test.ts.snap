// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Inference: raw reset > installs a polymorphic application handler for the shared unnamed effect 1`] = `
"reset @($anonymous : Π(r: Type) =>
  Effect (Π(x: Π(x: r) -> Num) -> Num) r) λ(r: Type) =>
  λ($payload: Π(x: Π(x: r) -> Num) -> Num) ->
    λ($k: Π(x: r) -> Num) -> $payload $k |10|"
`;

exports[`Inference: raw reset > keeps the body answer distinct from the handled answer 1`] = `
"reset @($anonymous : Π(r: Type) =>
  Effect (Π(x: Π(x: r) -> Num) -> String) r) λ(r: Type) =>
  λ($payload: Π(x: Π(x: r) -> Num) -> String) ->
    λ($k: Π(x: r) -> Num) -> $payload $k |suspend @($anonymous : Effect
  (Π(x: Π(x: Num) -> Num) -> String)
  Num) λ(k: Π(x: Num) -> Num) -> "hello"|"
`;
