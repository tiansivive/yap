exports[`inference: application > implicit insertion > inserts multiple implicit arguments when needed 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "?3 @ ?2",
      "?4 @ ?1",
      "String ~~ String",
    ],
    "term": "((λ(a: (?1 :: Type)) =>
  ((λ(b: (?2 :: Type)) =>
    (λ(c: String) -> c : Π(c: String) ->
      (closure: String -| Γ: c; b; a)) : Π(b: ?2) =>
    (closure: Π(c: String) -> String -| Γ: b; a)))
    @(?3 :: ?2) : Π(a: ?1) => (closure: Π(c: String) -> String -| Γ: a)))
  @(?4 :: ?1)
  "hello"",
    "type": "String",
  },
}
`;

