exports[`inference: application > implicit insertion > inserts implicit argument with correct type 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Type ~~ Type",
      "?1 @ Num",
      "String ~~ String",
    ],
    "term": "((λ(x: Num) =>
  (λ(y: String) -> y : Π(y: String) ->
    (closure: String -| Γ: y; x)) : Π(x: Num) =>
  (closure: Π(y: String) -> String -| Γ: x)))
  @(?1 :: Num)
  "hello"",
    "type": "String",
  },
}
`;

