exports[`inference: application > implicit insertion > inserts implicit argument when applying explicit arg to fn with implicit param 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "?2 @ ?1",
      "String ~~ String",
    ],
    "term": "((λ(x: (?1 :: Type)) =>
  (λ(y: String) -> y : Π(y: String) ->
    (closure: String -| Γ: y; x)) : Π(x: ?1) =>
  (closure: Π(y: String) -> String -| Γ: x)))
  @(?2 :: ?1)
  "hello"",
    "type": "String",
  },
}
`;

