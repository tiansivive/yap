// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`inference: match > branch unification > mismatched branch types: match 1 | 1 -> 2 | 3 -> "hello" 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Num ~~ Num",
      "Num ~~ Num",
      "Num ~~ Num",
      "String ~~ Num",
      "Num ~~ ?2",
      "String ~~ ?2",
    ],
    "term": "(λ(x: Num) -> match x | 1 -> 2 | 3 -> "hello" : Π(x: Num) ->
  (?2 :: (?1 :: Type)))",
    "type": "Π(x: Num) -> (closure: (?2 :: (?1 :: Type)) -| Γ: x)",
  },
}
`;

exports[`inference: match > match { x: 1 } | { x: a } -> a 1`] = `
{
  "displays": {
    "constraints": [
      "Num ~~ ?1",
      "Schema [ x: ?3 | ?4 ] ~~ Schema [ x: Num ]",
      "?3 ~~ ?3",
      "?3 ~~ ?6",
    ],
    "term": "match Struct [ x: 1 ] | Struct [ x: a | $row_4 ] -> a",
    "type": "?6",
  },
}
`;

exports[`inference: match > match 1 | 1 -> 2 1`] = `
{
  "displays": {
    "constraints": [
      "Num ~~ Num",
      "Num ~~ Num",
      "Num ~~ ?2",
    ],
    "term": "match 1 | 1 -> 2",
    "type": "?2",
  },
}
`;

exports[`inference: match > struct patterns > nested recursive struct patterns with application 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Schema [ foo: Schema [ y: ?2 | ?3 ], bar: ?5 | ?6 ] ~~ Num",
      "?5 ~~ Π(x: ?7) -> (closure: (?8 :: Type) -| Γ: x; $row_6; f; $row_3; y; x)",
      "?2 ~~ ?7",
      "Schema [ z: Schema [ w: ?10 | ?11 ] | ?12 ] ~~ Num",
      "?8 ~~ ?8",
      "?10 ~~ ?8",
      "?8 ~~ ?14",
      "?10 ~~ ?14",
    ],
    "term": "(λ(x: Num) ->
  match x
    | Struct [ foo: Struct [ y: y | $row_3 ], bar: f | $row_6 ] -> f y
    | Struct [ z: Struct [ w: w | $row_11 ] | $row_12 ] -> w : Π(x: Num) ->
  (?14 :: (?13 :: Type)))",
    "type": "Π(x: Num) -> (closure: (?14 :: (?13 :: Type)) -| Γ: x)",
  },
}
`;

exports[`inference: match > struct patterns > struct pattern with literal fields 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Schema [ x: Num, y: Num | ?1 ] ~~ Num",
      "Schema [ z: Num, w: Num | ?2 ] ~~ Num",
      "Num ~~ Num",
      "Num ~~ Num",
      "Num ~~ ?4",
      "Num ~~ ?4",
    ],
    "term": "(λ(x: Num) ->
  match x
    | Struct [ x: 1, y: 2 | $row_1 ] -> 11
    | Struct [ z: 3, w: 4 | $row_2 ] -> 22 : Π(x: Num) -> (?4 :: (?3 :: Type)))",
    "type": "Π(x: Num) -> (closure: (?4 :: (?3 :: Type)) -| Γ: x)",
  },
}
`;

