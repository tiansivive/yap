exports[`inference: match > variant patterns > match on variant tags: #nil, #cons 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Variant [ nil: ?2 | ?3 ] ~~ Num",
      "Variant [ cons: Schema [ 0: ?5, 1: ?7 | ?8 ] | ?9 ] ~~ Num",
      "Num ~~ Num",
      "Num ~~ Num",
      "Num ~~ ?11",
      "Num ~~ ?11",
    ],
    "term": "(λ(x: Num) ->
  match x
    | Variant [ nil: a | $row_3 ] -> 0
    | Variant [ cons: Struct [ 0: el, 1: rest | $row_8 ] | $row_9 ] ->
        1 : Π(x: Num) -> (?11 :: (?10 :: Type)))",
    "type": "Π(x: Num) -> (closure: (?11 :: (?10 :: Type)) -| Γ: x)",
  },
}
`;
