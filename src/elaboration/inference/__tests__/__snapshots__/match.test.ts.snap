      "?2 ~~ ?7",
      "Schema [ z: Schema [ w: ?11 | ?12 ] | ?13 ] ~~ Num",
      "?9 ~~ ?9",
      "?11 ~~ ?9",
      "?9 ~~ ?15",
      "?11 ~~ ?15",
    ],
    "term": "(λ(x: Num) ->
  match x
    | Struct [ foo: Struct [ y: y | $row_3 ], bar: f | $row_6 ] -> f y
    | Struct [ z: Struct [ w: w | $row_12 ] | $row_13 ] -> w : Π(x: Num) ->
  (closure: (?15 :: ?14) -| Γ: x))",
    "type": "Π(x: Num) -> (closure: (?15 :: ?14) -| Γ: x)",
  },
}
`;

