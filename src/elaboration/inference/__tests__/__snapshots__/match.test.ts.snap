exports[`inference: match > struct patterns > struct pattern with literal fields 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Schema [ x: Num, y: Num | ?1 ] ~~ Num",
      "Schema [ z: Num, w: Num | ?2 ] ~~ Num",
      "Num ~~ Num",
      "Num ~~ Num",
      "Num ~~ ?4",
      "Num ~~ ?4",
    ],
    "term": "(λ(x: Num) ->
  match x
    | Struct [ x: 1, y: 2 | $row_1 ] -> 11
    | Struct [ z: 3, w: 4 | $row_2 ] -> 22 : Π(x: Num) ->
  (closure: (?4 :: ?3) -| Γ: x))",
    "type": "Π(x: Num) -> (closure: (?4 :: ?3) -| Γ: x)",
  },
}
`;

