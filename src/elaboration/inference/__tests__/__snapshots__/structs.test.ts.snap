exports[`Inference: Structs > struct with computed field: { x: 1 + 2, y: "hello" } 1`] = `
{
  "displays": {
    "constraints": [
      "String ~~ ?2",
      "Num ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ ?1",
    ],
    "term": "Struct [ x: FFI.$add 1 2, y: "hello" ]",
    "type": "Schema
  [ x: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |],
    y: String ]",
  },
