exports[`Inference: Structs > dependent structs > dependent field referring to later field: { y: :x + 2, x: 1 } 1`] = `
{
  "displays": {
    "constraints": [
      "Num ~~ ?2",
      "?2 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ ?1",
    ],
    "term": "Struct [ y: FFI.$add :x 2, x: 1 ]",
    "type": "Schema
  [ y: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |],
    x: Num ]",
  },
}
`;

