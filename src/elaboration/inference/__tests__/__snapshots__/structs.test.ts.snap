{
  "displays": {
    "constraints": [
      "Schema [ y: ?5 | ?6 ] ~~ ?1",
      "?5 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ~~ ?4",
      "Schema [ x: ?7 | ?8 ] ~~ ?1",
      "?7 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ~~ ?3",
      "Schema
  [ a: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |],
    b: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ] ~~ ?2",
      "Num ~~ ?10",
      "Num ~~ ?9",
      "Schema [ x: Num, y: Num ] ~~ ?1",
    ],
    "term": "Struct
  [ point: Struct [ x: 1, y: 2 ],
    halved: Struct [ a: FFI.$div (:point).x 2, b: FFI.$div (:point).y 2 ] ]",
    "type": "Schema
  [ point: Schema [ x: Num, y: Num ],
    halved: Schema
      [ a: <ω> Num [| λ(r: Num) ->
          (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |],
        b: <ω> Num [| λ(r: Num) ->
          (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ] ]",
  },
}
`;

