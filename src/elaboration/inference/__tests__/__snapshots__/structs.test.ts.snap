{
  "displays": {
    "constraints": [
      "?1 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ ?2",
      "?2 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ ?1",
    ],
    "term": "Struct [ a: FFI.$add :b 1, b: FFI.$add :a 1 ]",
    "type": "Schema
  [ a: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |],
    b: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ]",
  },
}
`;

