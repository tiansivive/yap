exports[`Inference: Structs > dependent structs > nested dependent fields: { point: { x: 1, y: 2 }, halved: { a: $point.x / 2, b: $point.y / 2 } } 1`] = `
{
  "displays": {
    "constraints": [
      "Num ~~ ?3",
      "Num ~~ ?4",
      "Schema [ x: Num, y: Num ] ~~ ?1",
      "Schema [ x: ?7 | ?8 ] ~~ ?1",
      "?7 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ~~ ?5",
      "Schema [ y: ?9 | ?10 ] ~~ ?1",
      "?9 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ~~ ?6",
      "Schema
  [ a: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |],
    b: <ω> Num [| λ(r: Num) ->
      (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ] ~~ ?2",
    ],
    "term": "νstrict [ point: νstrict [] . Struct [ x: 1, y: 2 ] ] .
  Struct
    [ point: νstrict [] . Struct [ x: 1, y: 2 ],
      halved: νstrict [] .
        Struct [ a: FFI.$div ($point).x 2, b: FFI.$div ($point).y 2 ] ]",
    "type": "Schema
  [ point: Schema [ x: Num, y: Num ],
    halved: Schema
      [ a: <ω> Num [| λ(r: Num) ->
          (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |],
        b: <ω> Num [| λ(r: Num) ->
          (closure: FFI.$eq r (FFI.$div x y) -| Γ: r; y; x) |] ] ]",
  },
}
`;

