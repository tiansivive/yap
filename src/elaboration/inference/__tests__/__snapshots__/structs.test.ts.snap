exports[`Inference: Structs > dependent structs > nested shadowing dependencies: { overriden: 1, foo: { inner: $overriden }, bar: { overriden: "hello", inner: $overriden } 1`] = `
{
  "displays": {
    "constraints": [
      "Num ~~ ?1",
      "?1 ~~ ?4",
      "Schema [ inner: ?1 ] ~~ ?2",
      "String ~~ ?5",
      "?5 ~~ ?6",
      "Schema [ overriden: String, inner: ?5 ] ~~ ?3",
    ],
    "term": "νstrict [ overriden: 1 ] .
  Struct
    [ overriden: 1,
      foo: νstrict [] . Struct [ inner: $overriden ],
      bar: νstrict [ overriden: "hello" ] .
        Struct [ overriden: "hello", inner: $overriden ] ]",
    "type": "Schema
  [ overriden: Num,
    foo: Schema [ inner: ?1 ],
    bar: Schema [ overriden: String, inner: ?5 ] ]",
  },
}
`;

exports[`Inference: Structs > dependent structs > nested shadowing dependencies: { overriden: 1, foo: { inner: :overriden }, bar: { overriden: "hello", inner: :overriden } 1`] = `
{
  "displays": {
    "constraints": [
      "?4 ~~ ?5",
      "String ~~ ?4",
      "Schema [ overriden: String, inner: ?4 ] ~~ ?3",
      "?1 ~~ ?6",
      "Schema [ inner: ?1 ] ~~ ?2",
      "Num ~~ ?1",
    ],
    "term": "Struct
  [ overriden: 1,
    foo: Struct [ inner: :overriden ],
    bar: Struct [ overriden: "hello", inner: :overriden ] ]",
    "type": "Schema
  [ overriden: Num,
    foo: Schema [ inner: ?1 ],
    bar: Schema [ overriden: String, inner: ?4 ] ]",
  },
}
`;

