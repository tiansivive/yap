// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Normalization v2 (stack-based): evaluation / reduce / matching > delimited continuations (shift/reset) > models looping continuation 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Unit ~~ Unit",
      "Bool ~~ Bool",
      "Unit ~~ Unit",
      "?3 ~~ Π(x: ?7) -> (closure: (?8 :: Type) -| Γ: x; $k; u; go; body; cond; while)",
      "Unit ~~ ?7",
      "?8 ~~ ?5",
      "Unit ~~ ?2",
      "Bool ~~ Bool",
      "Unit ~~ ?2",
      "Π(u: ?4) -> (closure: (?5 :: Type) -| Γ: u; go; body; cond; while) ~~ ?3",
      "?9 @ Type",
      "Unit ~~ Unit",
      "?9 ~~ ?1",
      "?2 ~~ Unit",
    ],
    "term": "{
  let while
    : Π(a: Type) =>
      (closure: Π(t1: Π(t2: Unit) -> Bool) ->
        Π(t3: Π(t4: Unit) -> Unit) -> Unit -| Γ: a; while)
    = λ(a: Type) =>
      λ(cond: Π(t2: Unit) -> Bool) ->
        λ(body: Π(t4: Unit) -> Unit) ->
          reset |{
            let go
              : Π(a: Type) =>
                (closure: Π(x: Unit) -> a -| Γ: a; go; body; cond; while)
              = λ(a: Type) =>
                (λ(u: Unit) ->
                  bubble#6 (shift (λ($k: Π($k: go) -> a) ->
                    match body unit
                      | true -> { go unit; $k (a unit); return unit; }
                      | false -> unit)) : Π(u: Unit) -> a);
            return go @a unit;
          }|;
  return while;
}",
    "type": "Π(a: Type) =>
  (closure: Π(t1: Π(t2: Unit) -> Bool) ->
    Π(t3: Π(t4: Unit) -> Unit) -> Unit -| Γ: a; while)",
  },
  "evaluation": "λ(a: Type) =>
  (closure: λ(cond: Π(t2: Unit) -> Bool) ->
    λ(body: Π(t4: Unit) -> Unit) ->
      reset |{
        let go
          : Π(a: Type) =>
            (closure: Π(x: Unit) -> a -| Γ: a; go; body; cond; while)
          = λ(a: Type) =>
            (λ(u: Unit) ->
              bubble#6 (shift (λ($k: Π($k: go) -> a) ->
                match body unit
                  | true -> { go unit; $k (a unit); return unit; }
                  | false -> unit)) : Π(u: Unit) -> a);
        return go @a unit;
      }| -| Γ: a; while)",
}
`;

exports[`Normalization v2 (stack-based): evaluation / reduce / matching > delimited continuations (shift/reset) > shifts under a lambda (Bubble produces neutral without delimiter) 1`] = `
{
  "nfType": "Neutral",
  "pretty": {
    "constraints": [
      "Num ~~ Num",
      "?4 ~~ Num",
      "Num ~~ Num",
      "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ ?5",
      "?2 ~~ ?3",
      "?5 ~~ Num",
      "Π(x: ?4) ->
  (closure: <ω> Num [| λ(r: Num) ->
    FFI.$eq r (FFI.$add 1 (?6 :: ?5)) |] -| Γ: x; test) ~~ ?2",
      "?3 ~~ ?1",
      "Num ~~ ?4",
    ],
    "term": "{
  let test
    : Π(x: Num) ->
      (closure: <ω> Num [| λ(r: Num) ->
        FFI.$eq r
          (FFI.$add 1
            (?6 :: <ω> Num [| λ(r: Num) ->
              (closure: FFI.$eq r
                (FFI.$add x y) -| Γ: r; y; x) |])) |] -| Γ: x; test)
    = reset |(λ(x: Num) ->
      FFI.$add 1
        bubble#6 (shift (λ($k: Π($k: <ω> Num [| λ(r: Num) ->
          (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]) ->
          Π(x: Num) ->
            (closure: <ω> Num [| λ(r: Num) ->
              FFI.$eq r
                (FFI.$add 1
                  (?6 :: <ω> Num [| λ(r: Num) ->
                    (closure: FFI.$eq r
                      (FFI.$add x y) -| Γ: r; y; x) |])) |] -| Γ: x; test)) ->
          $k (FFI.$add x 10))) : Π(x: Num) ->
      <ω> Num [| λ(r: Num) ->
        FFI.$eq r
          (FFI.$add 1
            (?6 :: <ω> Num [| λ(r: Num) ->
              (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |])) |])|;
  return test 5;
}",
    "type": "<ω> Num [| λ(r: Num) ->
  (closure: FFI.$eq r
    (FFI.$add 1
      (?6 :: <ω> Num [| λ(r: Num) ->
        (closure: FFI.$eq r
          (FFI.$add x y) -| Γ: r; y; x) |])) -| Γ: r; x; test) |]",
  },
}
`;
