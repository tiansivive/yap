// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Shift-reset > multiple shifts within reset > invoking continuations 1`] = `
{
  "constraints": [
    "Num ~~ ?4",
    "?2 ~~ ?3",
    "?4 ~~ Num",
    "Num ~~ ?6",
    "?2 ~~ ?3",
    "?6 ~~ Num",
    "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ ?2",
    "?3 ~~ ?1",
  ],
  "solution": "?1 |=> <ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]
?2 |=> <ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]
?3 |=> <ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]
?4 |=> Num
?6 |=> Num",
  "state": {
    "nondeterminism": {
      "5": [
        "10",
      ],
      "7": [
        "20",
      ],
    },
  },
  "term": "let test
  : <ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]
  = reset |FFI.$add
    bubble#5 (shift (λ($k: Π($k: Num) ->
      <ω> Num [| λ(r: Num) ->
        (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]) ->
      $k 10))
    bubble#7 (shift (λ($k: Π($k: Num) ->
      <ω> Num [| λ(r: Num) ->
        (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]) ->
      $k 20))|",
  "type": "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |]",
}
`;

exports[`Shift-reset > multiple shifts within reset > multiple shifts and multiple resumptions 1`] = `
{
  "constraints": [
    "Num ~~ Num",
    "Num ~~ ?4",
    "?2 ~~ ?3",
    "?4 ~~ Num",
    "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ Num",
    "Num ~~ ?6",
    "?2 ~~ ?3",
    "?6 ~~ Num",
    "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ Num",
    "Num ~~ ?8",
    "?2 ~~ ?8",
    "?2 ~~ ?3",
    "?8 ~~ Num",
    "<ω> Num [| λ(r: Num) -> (closure: FFI.$eq r (FFI.$add x y) -| Γ: r; y; x) |] ~~ ?2",
    "?3 ~~ ?1",
  ],
  "solution": "?1 |=> Num
?2 |=> Num
?3 |=> Num
?4 |=> Num
?6 |=> Num
?8 |=> Num",
  "state": {
    "nondeterminism": {
      "5": [
        "3",
      ],
      "7": [
        "2",
      ],
      "9": [
        "L1 1",
        "1",
      ],
    },
  },
  "term": "let test
  : Num
  = reset |FFI.$add
    (FFI.$add (FFI.$add 4 bubble#5 (shift (λ($k: Π($k: Num) -> Num) -> $k 3)))
      bubble#7 (shift (λ($k: Π($k: Num) -> Num) -> $k 2)))
    bubble#9 (shift (λ($k: Π($k: Num) -> Num) -> $k ($k 1)))|",
  "type": "Num",
}
`;

exports[`Shift-reset > only one shift within reset > invoking id continuation 1`] = `
