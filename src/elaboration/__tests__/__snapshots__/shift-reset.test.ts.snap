// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Shift-reset > multiple shifts within reset > invoking continuations 1`] = `
{
  "constraints": [
    "Num ~~ ?4",
    "?2 ~~ ?3",
    "?4 ~~ Num",
    "Num ~~ ?6",
    "?2 ~~ ?3",
    "?6 ~~ Num",
    "Num ~~ ?2",
    "?3 ~~ ?1",
  ],
  "solution": "?1 |=> Num
?2 |=> Num
?3 |=> Num
?4 |=> Num
?6 |=> Num",
  "state": {
    "nondeterminism": {
      "5": [
        "10",
      ],
      "7": [
        "20",
      ],
    },
  },
  "term": "let test
  : Num
  = reset |FFI.$add bubble#1328 (shift (λ($k: Π($k: Num) -> Num) -> $k 10))
    bubble#1339 (shift (λ($k: Π($k: Num) -> Num) -> $k 20))|",
  "type": "Num",
}
`;

exports[`Shift-reset > multiple shifts within reset > multiple shifts and multiple resumptions 1`] = `
{
  "constraints": [
    "Num ~~ Num",
    "Num ~~ ?4",
    "?2 ~~ ?3",
    "?4 ~~ Num",
    "Num ~~ Num",
    "Num ~~ ?6",
    "?2 ~~ ?3",
    "?6 ~~ Num",
    "Num ~~ Num",
    "Num ~~ ?8",
    "?2 ~~ ?8",
    "?2 ~~ ?3",
    "?8 ~~ Num",
    "Num ~~ ?2",
    "?3 ~~ ?1",
  ],
  "solution": "?1 |=> Num
?2 |=> Num
?3 |=> Num
?4 |=> Num
?6 |=> Num
?8 |=> Num",
  "state": {
    "nondeterminism": {
      "5": [
        "3",
      ],
      "7": [
        "2",
      ],
      "9": [
        "L1 1",
        "1",
      ],
    },
  },
  "term": "let test
  : Num
  = reset |FFI.$add
    (FFI.$add
      (FFI.$add 4 bubble#1332 (shift (λ($k: Π($k: Num) -> Num) -> $k 3)))
      bubble#1344 (shift (λ($k: Π($k: Num) -> Num) -> $k 2)))
    bubble#1358 (shift (λ($k: Π($k: Num) -> Num) -> $k ($k 1)))|",
  "type": "Num",
}
`;

