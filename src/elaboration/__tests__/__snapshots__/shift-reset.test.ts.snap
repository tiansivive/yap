exports[`Shift-reset > resumption of dependent continuation > resuming continuation with dependent type 1`] = `
{
  "constraints": [
    "Type ~~ Type",
    "Num ~~ Num",
    "Type ~~ Type",
    "?3 ~~ Num",
    "Type ~~ Type",
    "Type ~~ Type",
    "Num ~~ Num",
    "Num ~~ Num",
    "?5 ~~ Num",
    "String ~~ String",
    "Num ~~ ?9",
    "?7 ~~ ?8",
    "?9 ~~ Num",
    "(λ($scrutinee: Any) ->
  (closure: match $scrutinee
    | 0 -> Num
    | _ -> String -| Γ: $scrutinee; x; test))
  ?1348 ~~ ?7",
    "?8 ~~ ?6",
    "Unit ~~ ?1",
  ],
  "solution": "?1 |=> Unit
?3 |=> Num
?5 |=> Num
?6 |=> (λ($scrutinee: Any) ->
  (closure: match $scrutinee
    | 0 -> Num
    | _ -> String -| Γ: $scrutinee; $scrutinee; $scrutinee; x; test))
  ?1348
?7 |=> (λ($scrutinee: Any) ->
  (closure: match $scrutinee
    | 0 -> Num
    | _ -> String -| Γ: $scrutinee; $scrutinee; x; test))
  ?1348
?8 |=> (λ($scrutinee: Any) ->
  (closure: match $scrutinee
    | 0 -> Num
    | _ -> String -| Γ: $scrutinee; $scrutinee; x; test))
  ?1348
?9 |=> Num",
  "state": {
    "nondeterminism": {
      "10": [
        "10",
      ],
    },
  },
  "term": "let test
  : Unit
  = {
    let f
      : Π(x: Num) -> (closure: match x | 0 -> Num | _ -> String -| Γ: x; test)
      = λ(x: Num) -> match x | 0 -> 0 | _ -> "hello";
    let foo
      : (λ($scrutinee: Any) ->
        (closure: match $scrutinee
          | 0 -> Num
          | _ -> String -| Γ: $scrutinee; $scrutinee; $scrutinee; x; test))
        ?1348
      = reset |f
        bubble#1348 (shift (λ($k: Π($k: Num) ->
          (λ($scrutinee: Any) ->
            (closure: match $scrutinee
              | 0 -> Num
              | _ -> String -| Γ: $scrutinee; $scrutinee; x; test))
            ?1348) ->
          $k 10))|;
    return unit;
  }",
  "type": "Unit",
}
`;
