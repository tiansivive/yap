exports[`Shift-reset > multiple captures within reset > invoking continuations 1`] = `
{
  "constraints": [
    "Num ~~ ?4",
    "?2 ~~ ?3",
    "?4 ~~ Num",
    "Num ~~ ?6",
    "?2 ~~ ?3",
