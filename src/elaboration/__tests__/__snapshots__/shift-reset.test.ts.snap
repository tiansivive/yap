      : Π($payload: Π(k: Π(x: $parameter2) ->
        (closure: Num -| Γ: x; r; test)) ->
        (closure: Num -| Γ: k; r; test)) ->
        (closure: Π($k: Π(x: $parameter2) -> Num) -> Num -| Γ: $payload; test)
      = λ($payload: Π(k: Π(x: $parameter2) -> Num) -> Num) ->
