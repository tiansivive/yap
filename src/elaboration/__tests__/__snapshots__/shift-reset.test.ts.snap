    "<ω> Num [| λ(st: State) ->
  (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |] ~~ ?2",
    "?3 ~~ ?1",
  ],
  "solution": "?1 |=> <ω> Num [| λ(st: State) ->
  (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]
?2 |=> <ω> Num [| λ(st: State) ->
  (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]
?3 |=> <ω> Num [| λ(st: State) ->
  (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]
?4 |=> Num
?6 |=> Num",
  "state": {
    "nondeterminism": {},
  },
  "term": "let test
  : <ω> Num [| λ(st: State) ->
    (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]
  = reset [$anonymous1] {
    let $handler
      : Π($payload: Π(k: Π(x: $parameter2) ->
        (closure: <ω> Num [| λ(st: State) ->
          (closure: λ(r: Num) ->
            FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |] -| Γ: x; r; test)) ->
        (closure: <ω> Num [| λ(st: State) ->
          (closure: λ(r: Num) ->
            FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |] -| Γ: k; r; test)) ->
        (closure: Π($k: Π(x: $parameter2) ->
          <ω> Num [| λ(st: State) ->
            (closure: λ(r: Num) ->
              FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]) ->
          <ω> Num [| λ(st: State) ->
            (closure: λ(r: Num) ->
              FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |] -| Γ: $payload; test)
      = λ($payload: Π(k: Π(x: $parameter2) ->
        <ω> Num [| λ(st: State) ->
          (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]) ->
        <ω> Num [| λ(st: State) ->
          (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]) ->
        λ($k: Π(x: $parameter2) ->
          <ω> Num [| λ(st: State) ->
            (closure: λ(r: Num) ->
              FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]) ->
          $payload $k;
    return $handler;
  } in |FFI.$add
    bubble#5 (capture [$anonymous1] (λ(k: Π(x: Num) ->
      <ω> Num [| λ(st: State) ->
        (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]) ->
      k 10))
    bubble#7 (capture [$anonymous1] (λ(k: Π(x: Num) ->
      <ω> Num [| λ(st: State) ->
        (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]) ->
      k 20))|",
  "type": "<ω> Num [| λ(st: State) ->
  (closure: λ(r: Num) -> FFI.$eq r (FFI.$add x y) -| Γ: st; y; x) |]",
