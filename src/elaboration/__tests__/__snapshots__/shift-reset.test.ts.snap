exports[`Shift-reset > resumption of dependent continuation > resuming continuation with dependent type 1`] = `
{
  "constraints": [
    "Type ~~ Type",
    "Num ~~ Num",
    "Type ~~ Type",
    "?3 ~~ Num",
    "Type ~~ Type",
    "Type ~~ Type",
    "Num ~~ Num",
    "Num ~~ Num",
    "?5 ~~ Num",
    "String ~~ String",
    "Num ~~ ?9",
    "?7 ~~ ?8",
    "?9 ~~ Num",
    "match ?10 … ~~ ?7",
    "?8 ~~ ?6",
    "Unit ~~ ?1",
  ],
  "solution": "?1 |=> Unit
?3 |=> Num
?5 |=> Num
?6 |=> String
?7 |=> String
?8 |=> String
?9 |=> Num
?10 |=> 10",
  "state": {
    "nondeterminism": {
      "10": [
        "10",
      ],
    },
  },
  "term": "let test
  : Unit
  = {
    let f
      : Π(x: Num) -> (closure: match x | 0 -> Num | _ -> String -| Γ: x; test)
      = λ(x: Num) -> match x | 0 -> 0 | _ -> "hello";
    let foo
      : String
      = reset |f bubble#10 (shift (λ($k: Π($k: Num) -> String) -> $k 10))|;
    return unit;
  }",
  "type": "Unit",
}
`;
