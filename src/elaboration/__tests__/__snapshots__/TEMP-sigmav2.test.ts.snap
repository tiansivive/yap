                     Schema [ x: Num, z: Num | r ] -| Γ: r)
               = λ(r: Row) =>
                 λ(rec: Σ($sig: [ x: Irrelevant ]) . Schema [ x: Num | r ]) ->
                   { rec | z = 0 };
             let p
               : Σ($sig: [ x: Irrelevant, z: Irrelevant ]) .
                 (closure: Schema [ x: Num, z: Num | r ] -| Γ: $sig; t1; r)
               = addZ @[] (ν($nu: [ x: Irrelevant ]) . Struct [ x: 1 ]);
             return p;
           }
type       Σ($sig: [ x: Irrelevant, z: Irrelevant ]) .
             (closure: Schema [ x: Num, z: Num | r ] -| Γ: $sig; t1; r)
normal     ν($nu: [ z: Irrelevant, x: Irrelevant ]) ->
             (closure: Struct [ z: 0, x: 1 ] -| Γ: $nu; p; addZ)
readback   ν($nu: [ z: Irrelevant, x: Irrelevant ]) . Struct [ z: 0, x: 1 ]"
`;

