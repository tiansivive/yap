// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Dependent Records > dependent pairs with path-dependent types > Dependent pair: matching singleton values pass 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Num ~~ ?1",
      "Type ~~ Type",
      "Num ~~ Num",
    ],
    "term": "{
  let Pair
    : Type
    = Σ($sig: [ fst: Irrelevant, snd: Irrelevant ]) .
      Schema [ fst: Num, snd: &fst ];
  let p
    : Σ($sig: [ fst: Irrelevant, snd: Irrelevant ]) .
      (closure: Schema [ fst: Num, snd: &fst ] -| Γ: $sig; Pair)
    = νstrict [] . Struct [ fst: 1, snd: 1 ];
  return p;
}",
    "type": "Σ($sig: [ fst: Irrelevant, snd: Irrelevant ]) .
  (closure: Schema [ fst: Num, snd: &fst ] -| Γ: $sig; Pair)",
  },
}
`;

exports[`Dependent Records > dependent pairs with path-dependent types > Pair instantiated with Num and String 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "?1 ~~ L1",
      "L1 ~~ ?1",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Num ~~ Num",
      "String ~~ String",
    ],
    "term": "{
  let Pair
    : Π(a: Type) -> (closure: Π(p: Π(t1: a) -> Type) -> Type -| Γ: a)
    = λ(a: Type) ->
      λ(p: Π(t1: a) -> Type) ->
        Σ($sig: [ fst: Irrelevant, snd: Irrelevant ]) .
          Schema [ fst: a, snd: p &fst ];
  let p
    : Σ($sig: [ fst: Irrelevant, snd: Irrelevant ]) .
      (closure: Schema [ fst: a, snd: p &fst ] -| Γ: $sig; p; a; Pair)
    = νstrict [] . Struct [ fst: 1, snd: "hello" ];
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Dependent Records > dependent pairs with path-dependent types > Pair: dependent pair with type dependent on first component 1`] = `
{
  "displays": {
