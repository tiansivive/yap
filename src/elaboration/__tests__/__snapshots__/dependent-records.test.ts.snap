      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "?1 ~~ L1",
      "L1 ~~ ?1",
    ],
    "term": "{
  let Pair
    : Π(a: Type) -> (closure: Π(p: Π(t1: a) -> Type) -> Type -| Γ: a)
    = λ(a: Type) ->
      λ(p: Π(t1: a) -> Type) ->
        Σ($sig: [ fst: Irrelevant, snd: Irrelevant ]) .
          Schema [ fst: a, snd: p &fst ];
  return unit;
}",
