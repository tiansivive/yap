exports[`Dependent Records > dependent pairs with refinement types > Dependent pair with refined second component 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "?1 ~~ L1",
      "L2 ~~ L2",
      "Bool ~~ Bool",
      "Type ~~ Type",
    ],
    "term": "{
  let Pair
    : Π(a: Type) ->
      (closure: Π(b: Type) ->
        Π(p: Π(t1: a) -> Π(t2: b) -> Bool) -> Type -| Γ: a)
    = λ(a: Type) ->
      λ(b: Type) ->
        λ(p: Π(t1: a) -> Π(t2: b) -> Bool) ->
          Σ($sig: [ snd: <ω> b [| λ(v: b) -> p :fst v |], fst: a ]) .
            Schema [ snd: <ω> b [| λ(v: b) -> p :fst v |], fst: a ];
  return unit;
}",
    "type": "Unit",
  },
}
`;
