// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Let-polymorphism > basic polymorphic let bindings > higher-order polymorphic function 1`] = `
{
  "displays": {
    "constraints": [
      "?2 ~~ Π(x: ?4) -> (closure: (?5 :: Type) -| Γ: x; x; f; apply)",
      "?3 ~~ ?4",
      "Π(f: ?2) -> (closure: Π(x: (?3 :: Type)) -> (?5 :: Type) -| Γ: f; apply) ~~ ?1",
      "Π(y: ?7) -> (closure: (?7 :: Type) -| Γ: y; id; apply) ~~ ?6",
      "?9 @ Type",
      "?10 @ Type",
      "?11 @ Type",
      "Π(y: ?11) -> (closure: a -| Γ: y; a; id; apply) ~~ Π(x: ?9) -> (closure: b -| Γ: x; b; a; apply)",
      "Num ~~ ?9",
      "?10 ~~ ?8",
    ],
    "term": "{
  let apply
    : Π(a: Type) =>
      (closure: Π(b: Type) => Π(f: Π(x: a) -> b) -> Π(x: a) -> b -| Γ: a; apply)
    = λ(a: Type) =>
      λ(b: Type) =>
        (λ(f: Π(x: a) -> b) -> (λ(x: a) -> f x : Π(x: a) -> b) : Π(f: Π(x: a) ->
          b) ->
          Π(x: a) -> b);
  let id
    : Π(a: Type) => (closure: Π(y: a) -> a -| Γ: a; id; apply)
    = λ(a: Type) => (λ(y: a) -> y : Π(y: a) -> a);
  let result : Num = apply @Num @Num (id @Num) 5;
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > basic polymorphic let bindings > polymorphic S combinator 1`] = `
{
  "displays": {
    "constraints": [
      "?2 ~~ Π(x: ?5) -> (closure: (?6 :: Type) -| Γ: x; x; g; f; s)",
      "?4 ~~ ?5",
      "?6 ~~ Π(x: ?7) -> (closure: (?8 :: Type) -| Γ: x; x; g; f; s)",
      "?3 ~~ Π(x: ?9) -> (closure: (?10 :: Type) -| Γ: x; x; g; f; s)",
      "?4 ~~ ?9",
      "?10 ~~ ?7",
      "Π(f: ?2) ->
  (closure: Π(g: (?3 :: Type)) -> Π(x: (?4 :: Type)) -> (?8 :: Type) -| Γ: f; s) ~~ ?1",
      "Π(a: ?12) -> (closure: Π(b: (?13 :: Type)) -> (?12 :: Type) -| Γ: a; const; s) ~~ ?11",
      "Π(n: ?15) -> (closure: (?15 :: Type) -| Γ: n; id; const; s) ~~ ?14",
      "?17 @ Type",
      "?18 @ Type",
      "?19 @ Type",
      "?20 @ Type",
      "?21 @ Type",
      "Π(a: ?20) -> (closure: Π(b: b) -> a -| Γ: a; b; a; const; s) ~~ Π(x: ?17) -> (closure: Π(x: b) -> c -| Γ: x; c; b; a; s)",
      "?22 @ Type",
      "Π(n: ?22) -> (closure: a -| Γ: n; a; id; const; s) ~~ Π(x: ?17) -> (closure: b -| Γ: x; f; c; b; a; s)",
      "Num ~~ ?17",
      "?19 ~~ ?16",
    ],
    "term": "{
  let s
    : Π(a: Type) =>
      (closure: Π(b: Type) =>
        Π(c: Type) =>
          Π(f: Π(x: a) -> Π(x: b) -> c) ->
            Π(g: Π(x: a) -> b) -> Π(x: a) -> c -| Γ: a; s)
    = λ(a: Type) =>
      λ(b: Type) =>
        λ(c: Type) =>
          (λ(f: Π(x: a) -> Π(x: b) -> c) ->
            (λ(g: Π(x: a) -> b) ->
              (λ(x: a) -> f x (g x) : Π(x: a) -> c) : Π(g: Π(x: a) -> b) ->
              Π(x: a) -> c) : Π(f: Π(x: a) -> Π(x: b) -> c) ->
            Π(g: Π(x: a) -> b) -> Π(x: a) -> c);
  let const
    : Π(a: Type) =>
      (closure: Π(b: Type) => Π(a: a) -> Π(b: b) -> a -| Γ: a; const; s)
    = λ(a: Type) =>
      λ(b: Type) =>
        (λ(a: a) -> (λ(b: b) -> a : Π(b: b) -> a) : Π(a: a) -> Π(b: b) -> a);
  let id
    : Π(a: Type) => (closure: Π(n: a) -> a -| Γ: a; id; const; s)
    = λ(a: Type) => (λ(n: a) -> n : Π(n: a) -> a);
  let result : Num = s @Num @Num @Num (const @Num @Num) (id @Num) 42;
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > basic polymorphic let bindings > polymorphic composition (B combinator) 1`] = `
{
  "displays": {
    "constraints": [
      "?2 ~~ Π(x: ?5) -> (closure: (?6 :: Type) -| Γ: x; x; g; f; compose)",
      "?3 ~~ Π(x: ?7) -> (closure: (?8 :: Type) -| Γ: x; x; g; f; compose)",
      "?4 ~~ ?7",
      "?8 ~~ ?5",
      "Π(f: ?2) ->
  (closure: Π(g: (?3 :: Type)) ->
    Π(x: (?4 :: Type)) -> (?6 :: Type) -| Γ: f; compose) ~~ ?1",
      "Π(n: ?10) -> (closure: (?10 :: Type) -| Γ: n; id; compose) ~~ ?9",
      "?12 @ Type",
      "?13 @ Type",
      "?14 @ Type",
      "?15 @ Type",
      "Π(n: ?15) -> (closure: a -| Γ: n; a; id; compose) ~~ Π(x: ?12) -> (closure: b -| Γ: x; c; b; a; compose)",
      "?16 @ Type",
      "Π(n: ?16) -> (closure: a -| Γ: n; a; id; compose) ~~ Π(x: ?14) -> (closure: a -| Γ: x; f; c; b; a; compose)",
      "Π(x: ?14) -> (closure: b -| Γ: x; g; f; c; b; a; compose) ~~ ?11",
    ],
    "term": "{
  let compose
    : Π(a: Type) =>
      (closure: Π(b: Type) =>
        Π(c: Type) =>
          Π(f: Π(x: a) -> b) ->
            Π(g: Π(x: c) -> a) -> Π(x: c) -> b -| Γ: a; compose)
    = λ(a: Type) =>
      λ(b: Type) =>
        λ(c: Type) =>
          (λ(f: Π(x: a) -> b) ->
            (λ(g: Π(x: c) -> a) ->
              (λ(x: c) -> f (g x) : Π(x: c) -> b) : Π(g: Π(x: c) -> a) ->
              Π(x: c) -> b) : Π(f: Π(x: a) -> b) ->
            Π(g: Π(x: c) -> a) -> Π(x: c) -> b);
  let id
    : Π(a: Type) => (closure: Π(n: a) -> a -| Γ: a; id; compose)
    = λ(a: Type) => (λ(n: a) -> n : Π(n: a) -> a);
  let result
    : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; result; id; compose)
    = λ(a: Type) => id @a @a @a (result @a) (result @a);
  return unit;
}",
    "type": "Unit",
  },
}
`;

