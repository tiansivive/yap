exports[`Let-polymorphism > basic polymorphic let bindings > polymorphic thrush (T combinator) 1`] = `
{
  "displays": {
    "constraints": [
      "?3 ~~ Π(x: ?4) -> (closure: (?5 :: Type) -| Γ: x; f; x; thrush)",
      "?2 ~~ ?4",
      "Π(x: ?2) -> (closure: Π(f: (?3 :: Type)) -> (?5 :: Type) -| Γ: x; thrush) ~~ ?1",
      "Π(n: ?7) -> (closure: (?7 :: Type) -| Γ: n; id; thrush) ~~ ?6",
      "?9 @ Type",
      "?10 @ Type",
      "Num ~~ ?9",
      "?11 @ Type",
      "Π(n: ?11) -> (closure: a -| Γ: n; a; id; thrush) ~~ Π(x: ?9) -> (closure: b -| Γ: x; x; b; a; thrush)",
      "?10 ~~ ?8",
    ],
    "term": "{
  let thrush
    : Π(a: Type) =>
      (closure: Π(b: Type) =>
        Π(x: a) -> Π(f: Π(x: a) -> b) -> b -| Γ: a; thrush)
    = λ(a: Type) =>
      λ(b: Type) =>
        (λ(x: a) ->
          (λ(f: Π(x: a) -> b) -> f x : Π(f: Π(x: a) -> b) -> b) : Π(x: a) ->
          Π(f: Π(x: a) -> b) -> b);
  let id
    : Π(a: Type) => (closure: Π(n: a) -> a -| Γ: a; id; thrush)
    = λ(a: Type) => (λ(n: a) -> n : Π(n: a) -> a);
  let result : Num = thrush @Num @Num 5 (id @Num);
  return unit;
}",
    "type": "Unit",
  },
}
`;

