exports[`Let-polymorphism > basic polymorphic let bindings > polymorphic flip (C combinator) 1`] = `
{
  "displays": {
    "constraints": [
      "?2 ~~ Π(x: ?5) -> (closure: (?6 :: Type) -| Γ: x; y; x; f; flip)",
      "?4 ~~ ?5",
      "?6 ~~ Π(x: ?7) -> (closure: (?8 :: Type) -| Γ: x; y; x; f; flip)",
      "?3 ~~ ?7",
      "Π(f: ?2) ->
  (closure: Π(x: (?3 :: Type)) ->
    Π(y: (?4 :: Type)) -> (?8 :: Type) -| Γ: f; flip) ~~ ?1",
      "Π(a: ?10) ->
  (closure: Π(b: (?11 :: Type)) -> (?10 :: Type) -| Γ: a; const; flip) ~~ ?9",
      "?13 @ Type",
      "?14 @ Type",
      "?15 @ Type",
      "?16 @ Type",
      "?17 @ Type",
      "Π(a: ?16) -> (closure: Π(b: b) -> a -| Γ: a; b; a; const; flip) ~~ Π(x: ?13) -> (closure: Π(x: b) -> c -| Γ: x; c; b; a; flip)",
      "Num ~~ ?14",
      "String ~~ ?13",
      "?15 ~~ ?12",
    ],
    "term": "{
  let flip
    : Π(a: Type) =>
      (closure: Π(b: Type) =>
        Π(c: Type) =>
          Π(f: Π(x: a) -> Π(x: b) -> c) ->
            Π(x: b) -> Π(y: a) -> c -| Γ: a; flip)
    = λ(a: Type) =>
      λ(b: Type) =>
        λ(c: Type) =>
          (λ(f: Π(x: a) -> Π(x: b) -> c) ->
            (λ(x: b) -> (λ(y: a) -> f y x : Π(y: a) -> c) : Π(x: b) ->
              Π(y: a) -> c) : Π(f: Π(x: a) -> Π(x: b) -> c) ->
            Π(x: b) -> Π(y: a) -> c);
  let const
    : Π(a: Type) =>
      (closure: Π(b: Type) => Π(a: a) -> Π(b: b) -> a -| Γ: a; const; flip)
    = λ(a: Type) =>
      λ(b: Type) =>
        (λ(a: a) -> (λ(b: b) -> a : Π(b: b) -> a) : Π(a: a) -> Π(b: b) -> a);
  let result
    : String
    = flip @String @Num @String (const @String @Num) 5 "hello";
  return unit;
}",
    "type": "Unit",
  },
}
`;

