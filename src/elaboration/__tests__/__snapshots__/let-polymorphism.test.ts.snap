exports[`Let-polymorphism > edge cases > multiple sequential polymorphic lets 1`] = `
{
  "displays": {
    "constraints": [
      "Π(x: ?2) -> (closure: (?2 :: Type) -| Γ: x; id1) ~~ ?1",
      "Π(y: ?4) -> (closure: (?4 :: Type) -| Γ: y; id2; id1) ~~ ?3",
      "Π(z: ?6) -> (closure: (?6 :: Type) -| Γ: z; id3; id2; id1) ~~ ?5",
      "?8 @ Type",
      "Num ~~ ?8",
      "?8 ~~ ?7",
      "?10 @ Type",
      "Bool ~~ ?10",
      "?10 ~~ ?9",
      "?12 @ Type",
      "Num ~~ ?12",
      "?12 ~~ ?11",
    ],
    "term": "{
  let id1
    : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; id1)
    = λ(a: Type) => (λ(x: a) -> x : Π(x: a) -> a);
  let id2
    : Π(a: Type) => (closure: Π(y: a) -> a -| Γ: a; id2; id1)
    = λ(a: Type) => (λ(y: a) -> y : Π(y: a) -> a);
  let id3
    : Π(a: Type) => (closure: Π(z: a) -> a -| Γ: a; id3; id2; id1)
    = λ(a: Type) => (λ(z: a) -> z : Π(z: a) -> a);
  let a : Num = id1 @Num 1;
  let b : Bool = id2 @Bool true;
  let c : Num = id3 @Num 42;
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > edge cases > polymorphic let returning polymorphic function 1`] = `
{
  "displays": {
    "constraints": [
      "Π(u: ?2) -> (closure: Π(x: (?3 :: Type)) -> (?3 :: Type) -| Γ: u; makeId) ~~ ?1",
      "?5 @ Type",
      "?6 @ Type",
      "Num ~~ ?5",
      "Π(x: ?6) -> (closure: b -| Γ: x; u; b; a; makeId) ~~ ?4",
      "?8 @ Type",
      "?9 @ Type",
      "Bool ~~ ?8",
      "Π(x: ?9) -> (closure: b -| Γ: x; u; b; a; makeId) ~~ ?7",
      "?11 @ Type",
      "String ~~ ?11",
      "?11 ~~ ?10",
      "?13 @ Type",
      "String ~~ ?13",
      "?13 ~~ ?12",
    ],
    "term": "{
  let makeId
    : Π(a: Type) =>
      (closure: Π(b: Type) => Π(u: a) -> Π(x: b) -> b -| Γ: a; makeId)
    = λ(a: Type) =>
      λ(b: Type) =>
        (λ(u: a) -> (λ(x: b) -> x : Π(x: b) -> b) : Π(u: a) -> Π(x: b) -> b);
  let id1
    : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; id1; makeId)
    = λ(a: Type) => id1 @Num @a 1;
  let id2
    : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; id2; id1; makeId)
    = λ(a: Type) => id1 @Bool @a true;
  let a : String = id1 @String "hello";
  let b : String = id2 @String "world";
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > let-polymorphism scope and capture > let-bound closure capturing polymorphic function 1`] = `
{
  "displays": {
    "constraints": [
      "Π(x: ?2) -> (closure: (?2 :: Type) -| Γ: x; id) ~~ ?1",
      "?5 @ Type",
      "?4 ~~ ?5",
      "Π(y: ?4) -> (closure: (?5 :: Type) -| Γ: y; makeApply; id) ~~ ?3",
      "?7 @ Type",
      "Num ~~ ?7",
      "?7 ~~ ?6",
      "?9 @ Type",
      "String ~~ ?9",
      "?9 ~~ ?8",
    ],
    "term": "{
  let id
    : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; id)
    = λ(a: Type) => (λ(x: a) -> x : Π(x: a) -> a);
  let makeApply
    : Π(a: Type) => (closure: Π(y: a) -> a -| Γ: a; makeApply; id)
    = λ(a: Type) => (λ(y: a) -> makeApply @a y : Π(y: a) -> a);
  let a : Num = makeApply @Num 5;
  let b : String = makeApply @String "hello";
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > let-polymorphism scope and capture > polymorphic let in nested scope 1`] = `
{
  "displays": {
    "constraints": [
      "Num ~~ ?1",
      "Π(x: ?4) -> (closure: (?4 :: Type) -| Γ: x; poly; inner; outer) ~~ ?3",
      "?6 @ Type",
      "Num ~~ ?6",
      "?6 ~~ ?5",
      "?8 @ Type",
      "String ~~ ?8",
      "?8 ~~ ?7",
      "?9 @ Type",
      "Π(x: ?9) -> (closure: a -| Γ: x; a; poly; inner; outer) ~~ ?2",
    ],
    "term": "{
  let outer : Num = 42;
  let inner
    : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; inner; outer)
    = λ(a: Type) =>
      ({
        let poly
          : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; poly; inner; outer)
          = λ(a: Type) => (λ(x: a) -> x : Π(x: a) -> a);
        let a : Num = poly @Num inner;
        let b : String = poly @String "test";
        return poly;
      })
        @a;
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > let-polymorphism with complex types > polymorphic function with projection 1`] = `
{
  "displays": {
    "constraints": [
      "Schema [ x: ?3 | ?4 ] ~~ ?2",
      "Π(p: ?2) -> (closure: (?3 :: Type) -| Γ: p; fst) ~~ ?1",
      "Num ~~ ?7",
      "Num ~~ ?6",
      "Schema [ x: Num, y: Num ] ~~ ?5",
      "Bool ~~ ?10",
      "Bool ~~ ?9",
      "Schema [ x: Bool, y: Bool ] ~~ ?8",
      "?12 @ Row",
      "?13 @ Type",
      "Schema [ x: Num, y: Num ] ~~ Schema [ x: ?13 | ?12 ]",
      "?13 ~~ ?11",
      "?15 @ Row",
      "?16 @ Type",
      "Schema [ x: Bool, y: Bool ] ~~ Schema [ x: ?16 | ?15 ]",
      "?16 ~~ ?14",
    ],
    "term": "{
  let fst
    : Π(r: Row) =>
      (closure: Π(a: Type) => Π(p: Schema [ x: a | r ]) -> a -| Γ: r; fst)
    = λ(r: Row) =>
      λ(a: Type) =>
        (λ(p: Schema [ x: a | r ]) -> (p).x : Π(p: Schema [ x: a | r ]) -> a);
  let val1 : Schema [ x: Num, y: Num ] = Struct [ x: 1, y: 2 ];
  let val2 : Schema [ x: Bool, y: Bool ] = Struct [ x: true, y: false ];
  let a : Num = fst @[ y: Num ] @Num val1;
  let b : Bool = fst @[ y: Bool ] @Bool val2;
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > let-polymorphism with complex types > polymorphic function with struct values 1`] = `
{
  "displays": {
    "constraints": [
      "Schema [ name: ?3 | ?4 ] ~~ ?2",
      "Π(obj: ?2) -> (closure: (?3 :: Type) -| Γ: obj; getName) ~~ ?1",
      "?6 @ Row",
      "?7 @ Type",
      "String ~~ ?7",
      "?7 ~~ ?8",
      "[] ~~ [ | ?6 ]",
      "?7 ~~ ?5",
      "?10 @ Row",
      "?11 @ Type",
      "String ~~ ?11",
      "?11 ~~ ?12",
      "Num ~~ ?13",
      "[ age: Num ] ~~ [ | ?10 ]",
      "?11 ~~ ?9",
    ],
    "term": "{
  let getName
    : Π(r: Row) =>
      (closure: Π(a: Type) =>
        Π(obj: Schema [ name: a | r ]) -> a -| Γ: r; getName)
    = λ(r: Row) =>
      λ(a: Type) =>
        (λ(obj: Schema [ name: a | r ]) -> (obj).name : Π(obj: Schema
          [ name: a | r ]) ->
          a);
  let alice : String = getName @[] @String (Struct [ name: "Alice" ]);
  let bob
    : String
    = getName @[ age: Num ] @String (Struct [ name: "Bob", age: 30 ]);
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > nested let bindings > nested polymorphic lets 1`] = `
{
  "displays": {
    "constraints": [
      "Π(y: ?4) -> (closure: (?4 :: Type) -| Γ: y; inner; x; outer) ~~ ?3",
      "?6 @ Type",
      "?2 ~~ ?6",
      "?6 ~~ ?5",
      "?8 @ Type",
      "Num ~~ ?8",
      "?8 ~~ ?7",
      "Π(x: ?2) -> (closure: Unit -| Γ: x; outer) ~~ ?1",
    ],
    "term": "{
  let outer
    : Π(a: Type) => (closure: Π(x: a) -> Unit -| Γ: a; outer)
    = λ(a: Type) =>
      (λ(x: a) ->
        {
          let inner
            : Π(a: Type) => (closure: Π(y: a) -> a -| Γ: a; inner; x; outer)
            = λ(a: Type) => (λ(y: a) -> y : Π(y: a) -> a);
          let x2 : a = inner @a x;
          let n : Num = inner @Num 42;
          return unit;
        } : Π(x: a) -> Unit);
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > nested let bindings > shadowing polymorphic lets 1`] = `
{
  "displays": {
    "constraints": [
      "Π(x: ?2) -> (closure: (?2 :: Type) -| Γ: x; id) ~~ ?1",
      "?4 @ Type",
      "Num ~~ ?4",
      "?4 ~~ ?3",
      "Π(y: ?6) -> (closure: (?6 :: Type) -| Γ: y; id; a; id) ~~ ?5",
      "?8 @ Type",
      "String ~~ ?8",
      "?8 ~~ ?7",
    ],
    "term": "{
  let id
    : Π(a: Type) => (closure: Π(x: a) -> a -| Γ: a; id)
    = λ(a: Type) => (λ(x: a) -> x : Π(x: a) -> a);
  let a : Num = id @Num 5;
  let id
    : Π(a: Type) => (closure: Π(y: a) -> a -| Γ: a; id; a; id)
    = λ(a: Type) => (λ(y: a) -> y : Π(y: a) -> a);
  let b : String = id @String "hello";
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > polymorphism on block scope > polymorphic return value on non resolved implicit 1`] = `
{
  "displays": {
    "constraints": [
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Type ~~ Type",
      "Num ~~ Num",
      "?2 @ Num",
      "Num ~~ Num",
      "?3 @ Num",
      "Num ~~ ?1",
    ],
    "term": "{
  let p
    : Π(A: Num) => (closure: Num -| Γ: A; p)
    = λ(A: Num) =>
      ({
        let f
          : Π(i: Num) => (closure: Π(t1: Num) -> Num -| Γ: i; p)
          = λ(i: Num) => λ(x: Num) -> x;
        return λ(A: Num) => f @A 1;
      })
        @A;
  return p;
}",
    "type": "Π(A: Num) => (closure: Num -| Γ: A; p)",
  },
}
`;

exports[`Let-polymorphism > recursive bindings > recursive function with polymorphic usage 1`] = `
{
  "displays": {
    "constraints": [
      "?1 ~~ Π(x: ?4) -> (closure: (?5 :: Type) -| Γ: x; y; x; rec)",
      "?2 ~~ ?4",
      "?5 ~~ Π(x: ?6) -> (closure: (?7 :: Type) -| Γ: x; y; x; rec)",
      "?3 ~~ ?6",
      "Π(x: ?2) -> (closure: Π(y: (?3 :: Type)) -> (?7 :: Type) -| Γ: x; rec) ~~ ?1",
      "?9 @ Type",
      "?10 @ Type",
      "?11 @ Type",
      "Num ~~ ?9",
      "Π(x: ?10) -> (closure: c -| Γ: x; x; c; b; a; rec) ~~ ?8",
    ],
    "term": "{
  let rec
    : Π(a: Type) =>
      (closure: Π(b: Type) =>
        Π(c: Type) => Π(x: a) -> Π(x: b) -> c -| Γ: a; rec)
    = λ(a: Type) =>
      λ(b: Type) =>
        λ(c: Type) =>
          (λ(x: a) -> (λ(y: b) -> c x y : Π(y: b) -> c) : Π(x: a) ->
            Π(y: b) -> c);
  let r
    : Π(a: Type) => (closure: Π(b: Type) => Π(x: a) -> b -| Γ: a; r; rec)
    = λ(a: Type) => λ(b: Type) => a @Num @a @b 5;
  return unit;
}",
    "type": "Unit",
  },
}
`;

exports[`Let-polymorphism > recursive bindings > simple recursive function 1`] = `
{
  "displays": {
    "constraints": [
      "?1 ~~ Π(x: ?3) -> (closure: (?4 :: Type) -| Γ: x; x; rec)",
      "?2 ~~ ?3",
      "Π(x: ?2) -> (closure: (?4 :: Type) -| Γ: x; rec) ~~ ?1",
    ],
    "term": "{
  let rec
    : Π(a: Type) => (closure: Π(b: Type) => Π(x: a) -> b -| Γ: a; rec)
    = λ(a: Type) => λ(b: Type) => (λ(x: a) -> b x : Π(x: a) -> b);
  return unit;
}",
    "type": "Unit",
  },
}
`;
