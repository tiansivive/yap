      "Π(a: ?9) ->
  (closure: Π(b: (?10 :: Type)) -> (?9 :: Type) -| Γ: a; const; warbler) ~~ ?8",
      "?12 @ Type",
      "?13 @ Type",
      "?14 @ Type",
      "?15 @ Type",
      "Π(a: ?14) -> (closure: Π(b: b) -> a -| Γ: a; b; a; const; warbler) ~~ Π(x: ?12) -> (closure: Π(x: a) -> b -| Γ: x; b; a; warbler)",
