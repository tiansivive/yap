exports[`Recursive lets > Mu wrapping of self-referencing type definitions > wraps an unannotated recursive variant definition 1`] = `
{
  "constraints": [
    "?1 ~~ Π(x: ?5) -> (closure: (?6 :: Type) -| Γ: x; $sig; t; List)",
    "?2 ~~ ?5",
    "Type ~~ Type",
    "Π(t: ?2) -> (closure: Type -| Γ: t; List) ~~ ?1",
  ],
  "solution": "?1 |=> Π(x: ?5) -> (closure: Type -| Γ: x; $sig; t; List)
?2 |=> ?5
?6 |=> Type",
  "state": {
    "nondeterminism": {},
  },
  "term": "let List
  : Π(x: ?5) -> (closure: Type -| Γ: x; $sig; t; List)
  = ([μ = List](x: Π(x: ?5) -> (closure: Type -| Γ: x; $sig; t; List))) ->
    (λ(t: ?5) ->
      Variant
        [ cons: Σ($sig: [ head: Irrelevant, tail: Irrelevant ]) .
            Schema [ head: t, tail: x t ],
          nil: Unit ] : Π(t: ?5) -> Type)",
  "type": "Π(x: ?5) -> (closure: Type -| Γ: x; $sig; t; List)",
}
`;

