// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Lowering: match > lowers match on literals (42, 0, wildcard) 1`] = `
{
  "mir": "module
  fn main entry=entry
    entry:
      let x0 = 42
      jump b5
    b5:
      branch x0 { 42 -> b2 | 0 -> b3; default -> b4 }
    b2:
      let x2 = 1
      jump b0(x2)
    b3:
      let x3 = 0
      jump b0(x3)
    b4:
      let x4 = -1
      jump b0(x4)
    b0(x1):
      return x1
    b1:
      let __match_fail = "non-exhaustive match"
      return __match_fail",
  "term": "match 42
| 42 -> 1
| 0 -> 0
| _ -> -1",
}
`;

exports[`Lowering: match > lowers match on nested struct with literal patterns 1`] = `
{
  "mir": "module
  fn main entry=entry
    entry:
      let x0 = 1
      let x1 = 2
      let x2 = alloc { x: x0, y: x1 }
      let x3 = alloc { outer: x2 }
      jump b5
    b5(x3):
      let x5 = read x3.outer
      jump b4(x5)
    b4(x5):
      let x6 = read x5.x
      let x7 = read x5.y
      jump b3
    b3:
      branch x6 { 1 -> b2; default -> b1 }
    b2:
      jump b0(x7)
    b0(x4):
      return x4
    b1:
      let __match_fail = "non-exhaustive match"
      return __match_fail",
  "term": "match Struct [ outer: Struct [ x: 1, y: 2 ] ]
| Struct [ outer: Struct [ x: 1, y: b ] ] -> b",
}
`;

