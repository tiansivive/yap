exports[`Lowering: match > lowers reset(Block) - resumes twice with different values, consumes shifted value in continuation and captured var - let x=5; let v = shift k-> k 10 + k 20; add(x, v) 1`] = `
{
  "mir": "module
  fn main entry=entry
    entry:
      let x0 = 5
      let env_1 = alloc { v0: x0 }
      let k_0 = alloc { __env: env_1 }
      jump s0(k_0)
    s0(k_1):
      let env_1 = read k_1.__env
      let x0 = read env_1.v0
      let x4 = 10
      let i_1 = 0
      jump r0(x4, env_1, i_1)
    s1(x5, env_2):
      let env_3 = update-immutable env_2 { r0: x5 }
      let x3 = read env_3.r0
      let x0 = read env_3.v0
      let x7 = 20
      let i_2 = 1
      jump r0(x7, env_3, i_2)
    s2(x8, env_4):
      let env_5 = update-immutable env_4 { r1: x8 }
      let x3 = read env_5.r0
      let x6 = read env_5.r1
      let x0 = read env_5.v0
      let x9 = +(x3, x6)
      jump reset_exit0(x9)
    r0(x1, env_0, i_0):
      let x0 = read env_0.v0
      let x2 = +(x1, x0)
      branch i_0 { 0 -> s1(x2, env_0) | 1 -> s2(x2, env_0) }
    reset_exit0(x10):
      return x10",
  "term": "reset |{
	let x
	: Num
	= 5;
	let v
	: Num
	= shift (λk -> FFI.$add (k 10) (k 20));
	return FFI.$add v x;
	}|",
}
`;

