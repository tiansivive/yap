exports[`Lowering: match > lowers match on literals (42, 0, wildcard) 1`] = `
{
  "mir": "module
  fn main entry=entry
    e0:
      let __match_fail = "non-exhaustive match"
      return __match_fail
    entry:
      let x1 = 42
      branch x1 { 42 -> c0 | 0 -> c1; default -> d0 }
    c0:
      let x2 = 1
      jump j0(x2)
    c1:
      let x3 = 0
      jump j0(x3)
    d0:
      let x4 = -1
      jump j0(x4)
    j0(x0):
      return x0",
  "term": "match 42
| 42 -> 1
| 0 -> 0
| _ -> -1",
}
`;

