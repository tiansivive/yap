exports[`Lowering: FFI > lowers unsaturated FFI captured via closure — (λf. f 'hi')(write 1) 1`] = `
{
  "mir": "module
  declare ffi write (arity 2)
  fn main entry=entry
    entry:
      let env_2 = alloc {  }
      let fnref_1 = &f_0
      let closure_0 = alloc { __fn: fnref_1, __env: env_2 }
      let x2 = 1
      let env_4 = alloc { v0: x2 }
      let fnref_2 = &f_1
      let closure_1 = alloc { __fn: fnref_2, __env: env_4 }
      let fnref_3 = read closure_0.__fn
      let env_5 = read closure_0.__env
      let x6 = call *fnref_3(env_5, closure_1)
      return x6
  fn f_0(env_0, f) entry=f_0_entry
    f_0_entry:
      let x0 = "hi"
      let fnref_0 = read f.__fn
      let env_1 = read f.__env
      let x1 = call *fnref_0(env_1, x0)
      return x1
  fn f_1(env_3, x3) entry=f_1_entry
    f_1_entry:
      let x4 = read env_3.v0
      let x5 = call write(x4, x3)
      return x5",
  "term": "(λ(f: Str) -> f "hi") (FFI.write 1)",
}
`;

