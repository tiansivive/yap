exports[`Lowering: match > lowers match on struct with literal patterns (x: 1 vs x: 2) 1`] = `
{
  "mir": "module
  fn main entry=entry
    e0:
      let __match_fail = "non-exhaustive match"
      return __match_fail
    entry:
      let x1 = 1
      let x2 = 10
      let x3 = alloc { x: x1, y: x2 }
      let x4 = read x3.x
      let x5 = read x3.y
      branch x4 { 1 -> c0 | 2 -> c1; default -> d0 }
    c0:
      jump j0(x5)
    c1:
      let x6 = 1
      let x7 = +(x5, x6)
      jump j0(x7)
    d0:
      let x8 = +(x4, x5)
      jump j0(x8)
    j0(x0):
      return x0",
  "term": "match Struct [ x: 1, y: 10 ]
  | Struct [ x: 1, y: b ] -> _
  | Struct [ x: 2, y: b ] -> FFI.$add _ 1
  | Struct [ x: a, y: b ] -> FFI.$add _ _",
}
`;

exports[`Lowering: match > lowers match on variant (Some/None) 1`] = `
{
  "mir": "module
  fn main entry=entry
    e0:
      let __match_fail = "non-exhaustive match"
      return __match_fail
    entry:
      let x1 = Some
      let x2 = 42
      let x3 = alloc { __tag: x1, payload: x2 }
      let x6 = read x3.__tag
      branch x6 { Some -> c0(x3) | None -> c1(x3); default -> e0 }
    c0(scrut_0):
      let x4 = read scrut_0.payload
      jump j0(x4)
    c1(scrut_1):
      let x5 = read scrut_1.payload
      let x7 = 0
      jump j0(x7)
    j0(x0):
      return x0",
  "term": "match Struct [ __tag: Some, payload: 42 ]
  | Variant [ Some: x ] -> _
  | Variant [ None: _ ] -> 0",
}
`;

exports[`Lowering: match > lowers match on variant with struct payload (Some(Point)) 1`] = `
{
  "mir": "module
  fn main entry=entry
    e0:
      let __match_fail = "non-exhaustive match"
      return __match_fail
    entry:
      let x1 = Some
      let x2 = 1
      let x3 = 2
      let x4 = alloc { x: x2, y: x3 }
      let x5 = alloc { __tag: x1, payload: x4 }
      let x8 = read x5.__tag
      branch x8 { Some -> c0(x5) | None -> c1(x5); default -> e0 }
    c0(scrut_0):
      let x6 = read scrut_0.payload
      let x9 = read x6.x
      let x10 = read x6.y
      branch x9 { 1 -> c2; default -> e0 }
    c2:
      jump j0(x10)
    c1(scrut_1):
      let x7 = read scrut_1.payload
      let x11 = 0
      jump j0(x11)
    j0(x0):
      return x0",
  "term": "match Struct [ __tag: Some, payload: Struct [ x: 1, y: 2 ] ]
  | Variant [ Some: Struct [ x: 1, y: b ] ] -> _
  | Variant [ None: _ ] -> 0",
}
`;

