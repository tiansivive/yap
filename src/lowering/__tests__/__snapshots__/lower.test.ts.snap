// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Lowering: FFI > lowers FFI inside lambda — λx. print(x) 1`] = `
{
  "mir": "module
  declare ffi print (arity 1)
  fn main entry=entry
    entry:
      let env_1 = alloc {  }
      let fnref_0 = &f_0
      let closure_0 = alloc { __fn: fnref_0, __env: env_1 }
      return closure_0
  fn f_0(env_0, x) entry=f_0_entry
    f_0_entry:
      let x0 = call print(x)
      return x0",
  "term": "λ(x: Str) -> FFI.print x",
}
`;

exports[`Lowering: FFI > lowers partially applied FFI — write(fd) (arity 2, 1 arg) → closure wrapper 1`] = `
{
  "mir": "module
  declare ffi write (arity 2)
  fn main entry=entry
    entry:
      let x0 = 1
      let env_1 = alloc { v0: x0 }
      let fnref_0 = &f_0
      let closure_0 = alloc { __fn: fnref_0, __env: env_1 }
      return closure_0
  fn f_0(env_0, x1) entry=f_0_entry
    f_0_entry:
      let x2 = read env_0.v0
      let x3 = call write(x2, x1)
      return x3",
  "term": "FFI.write 1",
}
`;

