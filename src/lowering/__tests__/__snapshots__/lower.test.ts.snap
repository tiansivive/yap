exports[`Lowering: match > lowers match on struct with literal patterns (x: 1 vs x: 2) 1`] = `
{
  "mir": "module
  fn main entry=entry
    entry:
      let x0 = 1
      let x1 = 10
      let x2 = alloc { x: x0, y: x1 }
      jump b6
    b6(x2):
      let x4 = read x2.x
      let x5 = read x2.y
      jump b5
    b5:
      branch x4 { 1 -> b2 | 2 -> b3; default -> b4 }
    b2:
      jump b0(x5)
    b3:
      let x6 = 1
      let x7 = +(x5, x6)
      jump b0(x7)
    b4:
      let x8 = +(x4, x5)
      jump b0(x8)
    b0(x3):
      return x3
    b1:
      let __match_fail = "non-exhaustive match"
      return __match_fail",
  "term": "match Struct [ x: 1, y: 10 ]
| Struct [ x: 1, y: b ] -> _
| Struct [ x: 2, y: b ] -> FFI.$add _ 1
| Struct [ x: a, y: b ] -> FFI.$add _ _",
}
`;

exports[`Lowering: match > lowers match on variant (Some/None) 1`] = `
{
  "mir": "module
  fn main entry=entry
    entry:
      let x0 = "Some"
      let x1 = 42
      let x2 = alloc { __tag: x0, Some: x1 }
      jump b4
    b4:
      let x7 = read x2.__tag
      branch x7 { Some -> b2(x2) | None -> b3(x2); default -> b1 }
    b2(scrut_0):
      let x4 = read scrut_0.Some
      jump b0(x4)
    b3(scrut_1):
      let x5 = read scrut_1.None
      let x6 = 0
      jump b0(x6)
    b0(x3):
      return x3
    b1:
      let __match_fail = "non-exhaustive match"
      return __match_fail",
  "term": "match Struct [ __tag: "Some", Some: 42 ]
| Variant [ Some: x ] -> _
| Variant [ None: _ ] -> 0",
}
`;

exports[`Lowering: match > lowers match on variant with struct payload (Some(Point)) 1`] = `
{
  "mir": "module
  fn main entry=entry
    entry:
      let x0 = "Some"
      let x1 = 1
      let x2 = 2
      let x3 = alloc { x: x1, y: x2 }
      let x4 = alloc { __tag: x0, Some: x3 }
      jump b7
    b7:
      let x11 = read x4.__tag
      branch x11 { Some -> b2(x4) | None -> b6(x4); default -> b1 }
    b2(scrut_0):
      let x6 = read scrut_0.Some
      jump b5(x6)
    b5(x6):
      let x7 = read x6.x
      let x8 = read x6.y
      jump b4
    b4:
      branch x7 { 1 -> b3; default -> b1 }
    b3:
      jump b0(x8)
    b6(scrut_1):
      let x9 = read scrut_1.None
      let x10 = 0
      jump b0(x10)
    b0(x5):
      return x5
    b1:
      let __match_fail = "non-exhaustive match"
      return __match_fail",
  "term": "match Struct [ __tag: "Some", Some: Struct [ x: 1, y: 2 ] ]
| Variant [ Some: Struct [ x: 1, y: b ] ] -> _
| Variant [ None: _ ] -> 0",
}
`;

