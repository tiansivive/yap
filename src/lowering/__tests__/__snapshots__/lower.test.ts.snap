exports[`Lowering: match > lowers match on literals (42, 0, wildcard) 1`] = `
{
  "mir": "module
  fn main entry=entry
    e0:
      let __match_fail = "non-exhaustive match"
      return __match_fail
    entry:
      let x1 = 42
      branch x1 { 42 -> c0 | 0 -> c1; default -> d0 }
    c0:
      let x2 = 1
      jump j0(x2)
    c1:
      let x3 = 0
      jump j0(x3)
    d0:
      let x4 = -1
      jump j0(x4)
    j0(x0):
      return x0",
  "term": "match 42 | 42 -> 1 | 0 -> 0 | _ -> -1",
}
`;

exports[`Lowering: match > lowers match on nested struct with literal patterns 1`] = `
{
  "mir": "module
  fn main entry=entry
    e0:
      let __match_fail = "non-exhaustive match"
      return __match_fail
    entry:
      let x1 = 1
      let x2 = 2
      let x3 = alloc { x: x1, y: x2 }
      let x4 = alloc { outer: x3 }
      let x5 = read x4.outer
      let x6 = read x5.x
      let x7 = read x5.y
      branch x6 { 1 -> c0; default -> e0 }
    c0:
      jump j0(x7)
    j0(x0):
      return x0",
  "term": "match Struct [ outer: Struct [ x: 1, y: 2 ] ]
  | Struct [ outer: Struct [ x: 1, y: b ] ] -> b",
}
`;

