// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Lowering v2 (monadic) > lowers (λx.x) 42 (indirect call) 1`] = `
"module
  fn main entry=entry
    entry:
      let env_1 = alloc {  }
      let fnref_0 = &f_0
      let closure_0 = alloc { __fn: fnref_0, __env: env_1 }
      let x0 = 42
      let fnref_1 = read closure_0.__fn
      let env_2 = read closure_0.__env
      let x1 = call *fnref_1(env_2, x0)
      return x1
  fn f_0(env_0, x) entry=f_0_entry
    f_0_entry:
      return x"
`;

exports[`Lowering v2 (monadic) > lowers (λx.λy.x) 1 2 (curried const, closure capture) 1`] = `
"module
  fn main entry=entry
    entry:
      let env_3 = alloc {  }
      let fnref_1 = &f_0
      let closure_1 = alloc { __fn: fnref_1, __env: env_3 }
      let x1 = 1
      let fnref_2 = read closure_1.__fn
      let env_4 = read closure_1.__env
      let x2 = call *fnref_2(env_4, x1)
      let x3 = 2
      let fnref_3 = read x2.__fn
      let env_5 = read x2.__env
      let x4 = call *fnref_3(env_5, x3)
      return x4
  fn f_1(env_1, y) entry=f_1_entry
    f_1_entry:
      let x0 = read env_1.v0
      return x0
  fn f_0(env_0, x) entry=f_0_entry
    f_0_entry:
      let env_2 = alloc { v0: x }
      let fnref_0 = &f_1
      let closure_0 = alloc { __fn: fnref_0, __env: env_2 }
      return closure_0"
`;

