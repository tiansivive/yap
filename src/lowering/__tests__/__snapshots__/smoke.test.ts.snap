exports[`Lowering v2 (monadic) > lowers reset(Block) with captured frame — let x=1; shift k->k 10; x+100 1`] = `
"module
  fn main entry=entry
    entry:
      let x0 = 1
      let env_1 = alloc { v0: x0 }
      let k_0 = alloc { __env: env_1 }
      jump s0(k_0)
    s0(k_1):
      let env_1 = read k_1.__env
      let x0 = read env_1.v0
      let x5 = 10
      let i_1 = 0
      jump r0(x5, env_1, i_1)
    s1(x6, env_2):
      let env_3 = update-immutable env_2 { r0: x6 }
      let x4 = read env_3.r0
      let x0 = read env_3.v0
      jump reset_exit0(x4)
    r0(x1, env_0, i_0):
      let x0 = read env_0.v0
      let x2 = 100
      let x3 = +(x0, x2)
      branch i_0 { 0 -> s1(x3, env_0) }
    reset_exit0(x7):
      return x7"
`;

