{
	"git": {
		"commitMessage": "chore: release v${version}",
		"requireCommits": true,
		"tagName": "v${version}"
	},
	"github": {
		"autoGenerate": true,
		"release": false,
		"releaseName": "v${version}"
	},
	"hooks": {
		"after:bump": "pnpm nearley && pnpm build && mkdir -p dist && pnpm pack --pack-destination dist",
		"before:init": "pnpm nearley && pnpm test && pnpm typecheck"
	},
	"npm": {
		"publish": false,
		"publishArgs": ["--access", "public", "--provenance"]
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "CHANGELOG.md",
			"preset": "angular"
		}
	}
}
